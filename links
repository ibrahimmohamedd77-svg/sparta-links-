<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sparta Technology Solutions | Connect With Us</title>
    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <!-- QRCode.js CDN for client-side QR code generation in modal -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <style>
        :root {
            --sparta-navy: #0A192F;
            --sparta-navy-surface: #112240;
            --sparta-blue: #2563EB;
            --sparta-blue-deep: #1D4ED8;
            --sparta-slate: #1E293B;
            --sparta-slate-hover: #273549;
            --text-primary: #FFFFFF;
            --text-secondary: #94A3B8;
            --border-subtle: rgba(255, 255, 255, 0.1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--sparta-navy);
            background-image:
                radial-gradient(circle at 50% 0%, rgba(37, 99, 235, 0.22) 0%, rgba(10, 25, 47, 0) 58%),
                radial-gradient(circle at 85% 90%, rgba(29, 78, 216, 0.14) 0%, rgba(10, 25, 47, 0) 50%);
            color: var(--text-primary);
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
            overflow-x: hidden;
        }

        /* Main Standalone Container */
        .page-wrapper {
            width: 100%;
            max-width: 440px;
            display: flex;
            flex-direction: column;
            align-items: center;
            animation: fadeUp 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(14px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Central Executive Card */
        .brand-card {
            width: 100%;
            background: rgba(17, 34, 64, 0.72);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1px solid var(--border-subtle);
            border-radius: 28px;
            padding: 36px 24px 32px;
            box-shadow:
                0 25px 50px -12px rgba(0, 0, 0, 0.55),
                inset 0 1px 0 rgba(255, 255, 255, 0.08);
            text-align: center;
        }

        /* Geometric Shield Emblem */
        .emblem-ring {
            width: 74px;
            height: 74px;
            margin: 0 auto 20px;
            border-radius: 22px;
            background: linear-gradient(145deg, var(--sparta-blue) 0%, var(--sparta-blue-deep) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow:
                0 12px 28px -4px rgba(37, 99, 235, 0.45),
                inset 0 1px 1px rgba(255, 255, 255, 0.3);
            position: relative;
        }

        .brand-title {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
            font-size: 1.25rem;
            font-weight: 800;
            letter-spacing: 0.04em;
            line-height: 1.3;
            color: var(--text-primary);
            margin-bottom: 8px;
        }

        .brand-tagline {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--text-secondary);
            line-height: 1.45;
            margin-bottom: 30px;
        }

        /* Action Cards Stack */
        .action-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
            width: 100%;
        }

        .action-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            width: 100%;
            padding: 18px 18px;
            border-radius: 18px;
            text-decoration: none;
            color: var(--text-primary);
            text-align: left;
            transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
            position: relative;
        }

        .action-card:active {
            transform: scale(0.98);
        }

        /* Card 1: Official Website (Vibrant Blue Primary) */
        .action-card--website {
            background: linear-gradient(135deg, var(--sparta-blue) 0%, var(--sparta-blue-deep) 100%);
            border: 1px solid rgba(255, 255, 255, 0.18);
            box-shadow: 0 10px 25px -5px rgba(37, 99, 235, 0.42);
        }

        .action-card--website:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px -5px rgba(37, 99, 235, 0.55);
        }

        /* Card 2: LinkedIn (Sleek Slate/Charcoal Executive) */
        .action-card--linkedin {
            background: var(--sparta-slate);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.35);
        }

        .action-card--linkedin:hover {
            background: var(--sparta-slate-hover);
            border-color: rgba(255, 255, 255, 0.22);
            transform: translateY(-2px);
        }

        .action-left {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }

        .action-icon-box {
            width: 44px;
            height: 44px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .action-card--website .action-icon-box {
            background: rgba(255, 255, 255, 0.16);
        }

        .action-card--linkedin .action-icon-box {
            background: rgba(37, 99, 235, 0.18);
            color: #60A5FA;
        }

        .action-text {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .action-title {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: #FFFFFF;
            line-height: 1.25;
        }

        .action-subtitle {
            font-size: 0.78rem;
            font-weight: 400;
            margin-top: 3px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .action-card--website .action-subtitle {
            color: rgba(255, 255, 255, 0.85);
        }

        .action-card--linkedin .action-subtitle {
            color: var(--text-secondary);
        }

        .action-arrow {
            flex-shrink: 0;
            opacity: 0.8;
            transition: transform 0.2s ease, opacity 0.2s ease;
        }

        .action-card:hover .action-arrow {
            transform: translate(2px, -2px);
            opacity: 1;
        }

        /* Subtle Footer & Share Trigger */
        .page-footer {
            margin-top: 24px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
        }

        .qr-trigger-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            border-radius: 9999px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #CBD5E1;
            font-family: 'Inter', sans-serif;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
        }

        .qr-trigger-btn:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(255, 255, 255, 0.24);
            color: #FFFFFF;
        }

        .copyright {
            font-size: 0.74rem;
            color: #64748B;
        }

        /* Modal Overlay */
        .modal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(4, 11, 22, 0.78);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
            z-index: 100;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.22s ease;
        }

        .modal-backdrop.is-open {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-card {
            width: 100%;
            max-width: 390px;
            background: #112240;
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 24px;
            padding: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
            transform: scale(0.95) translateY(8px);
            transition: transform 0.24s cubic-bezier(0.16, 1, 0.3, 1);
            text-align: center;
        }

        .modal-backdrop.is-open .modal-card {
            transform: scale(1) translateY(0);
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .modal-title {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: #FFFFFF;
        }

        .modal-close {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(255, 255, 255, 0.05);
            color: #94A3B8;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background 0.15s ease, color 0.15s ease;
        }

        .modal-close:hover {
            background: rgba(255, 255, 255, 0.12);
            color: #FFFFFF;
        }

        .qr-frame {
            background: #FFFFFF;
            padding: 16px;
            border-radius: 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin: 6px auto 16px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
        }

        #qrcode-container img,
        #qrcode-container canvas {
            display: block;
            max-width: 100%;
            height: auto;
        }

        .url-field-group {
            text-align: left;
            margin-bottom: 16px;
        }

        .url-label {
            display: block;
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #94A3B8;
            margin-bottom: 6px;
        }

        .url-input {
            width: 100%;
            padding: 11px 13px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.14);
            background: #0A192F;
            color: #FFFFFF;
            font-family: 'Inter', sans-serif;
            font-size: 0.82rem;
            outline: none;
            transition: border-color 0.18s ease;
        }

        .url-input:focus {
            border-color: var(--sparta-blue);
        }

        .modal-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .btn-download {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 12px 14px;
            border-radius: 12px;
            font-family: 'Inter', sans-serif;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: transform 0.15s ease, background-color 0.18s ease;
        }

        .btn-download:active {
            transform: scale(0.97);
        }

        .btn-download--png {
            background: var(--sparta-blue);
            color: #FFFFFF;
        }

        .btn-download--png:hover {
            background: var(--sparta-blue-deep);
        }

        .btn-download--svg {
            background: var(--sparta-slate);
            color: #FFFFFF;
            border: 1px solid rgba(255, 255, 255, 0.12);
        }

        .btn-download--svg:hover {
            background: var(--sparta-slate-hover);
        }

        /* Toast feedback */
        .toast {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%) translateY(16px);
            background: #1E293B;
            color: #FFFFFF;
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 10px 18px;
            border-radius: 9999px;
            font-size: 0.8rem;
            font-weight: 600;
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.45);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.22s ease, transform 0.22s ease;
            z-index: 200;
            white-space: nowrap;
        }

        .toast.is-visible {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
    </style>
</head>
<body>

    <div class="page-wrapper">
        <!-- Main Brand & Action Card -->
        <main class="brand-card">
            <!-- Geometric Shield / Sparta Emblem -->
            <div class="emblem-ring" aria-hidden="true">
                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2L3.5 6.5V12.5C3.5 17.6 7.1 22.1 12 23.3C16.9 22.1 20.5 17.6 20.5 12.5V6.5L12 2Z"/>
                    <path d="M12 6.5L16.5 9V12.5C16.5 15.2 14.6 17.6 12 18.4C9.4 17.6 7.5 15.2 7.5 12.5V9L12 6.5Z" fill="rgba(255,255,255,0.16)"/>
                    <path d="M9.5 12.2L11.2 13.9L14.8 10.3"/>
                </svg>
            </div>

            <h1 class="brand-title">SPARTA TECHNOLOGY SOLUTIONS</h1>
            <p class="brand-tagline">Customer Experience &amp; Managed IT Services</p>

            <!-- Two Primary Thumb-Friendly Action Cards -->
            <nav class="action-list" aria-label="Sparta Technology Solutions Links">
                <!-- Primary Card 1: Official Website -->
                <a href="https://www.spartats.com/" target="_blank" rel="noopener noreferrer" class="action-card action-card--website">
                    <div class="action-left">
                        <div class="action-icon-box" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="2" y1="12" x2="22" y2="12"/>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                            </svg>
                        </div>
                        <div class="action-text">
                            <span class="action-title">Visit Official Website</span>
                            <span class="action-subtitle">spartats.com</span>
                        </div>
                    </div>
                    <svg class="action-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="7" y1="17" x2="17" y2="7"/>
                        <polyline points="7 7 17 7 17 17"/>
                    </svg>
                </a>

                <!-- Primary Card 2: LinkedIn Company Page -->
                <a href="https://www.linkedin.com/company/80731418/" target="_blank" rel="noopener noreferrer" class="action-card action-card--linkedin">
                    <div class="action-left">
                        <div class="action-icon-box" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
                            </svg>
                        </div>
                        <div class="action-text">
                            <span class="action-title">Connect on LinkedIn</span>
                            <span class="action-subtitle">linkedin.com/company/sparta-technology-solutions</span>
                        </div>
                    </div>
                    <svg class="action-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="7" y1="17" x2="17" y2="7"/>
                        <polyline points="7 7 17 7 17 17"/>
                    </svg>
                </a>
            </nav>
        </main>

        <!-- Subtle Footer with QR Code Modal Trigger -->
        <footer class="page-footer">
            <button type="button" id="open-qr-modal" class="qr-trigger-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="7" height="7" rx="1"/>
                    <rect x="14" y="3" width="7" height="7" rx="1"/>
                    <rect x="3" y="14" width="7" height="7" rx="1"/>
                    <path d="M14 14h3v3h-3z"/>
                    <path d="M17 17h4v4h-4z"/>
                    <path d="M14 21h3"/>
                </svg>
                <span>Share / Get QR Code</span>
            </button>
            <span class="copyright">&copy; <span id="current-year"></span> Sparta Technology Solutions</span>
        </footer>
    </div>

    <!-- QR Code Modal -->
    <div id="qr-modal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="qr-modal-title">
        <div class="modal-card">
            <div class="modal-header">
                <h2 id="qr-modal-title" class="modal-title">Scan to Open This Page</h2>
                <button type="button" id="close-qr-modal" class="modal-close" aria-label="Close QR modal">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>

            <div class="qr-frame">
                <div id="qrcode-container"></div>
            </div>

            <div class="url-field-group">
                <label for="hosted-url-input" class="url-label">Hosted Page URL</label>
                <input type="url" id="hosted-url-input" class="url-input" placeholder="https://links.spartats.com" autocomplete="off">
            </div>

            <div class="modal-actions">
                <button type="button" id="download-png-btn" class="btn-download btn-download--png">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                    <span>High-Res PNG</span>
                </button>
                <button type="button" id="download-svg-btn" class="btn-download btn-download--svg">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                    <span>Download SVG</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Non-blocking Toast Notification -->
    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <script>
        (function () {
            const DEFAULT_FALLBACK_URL = 'https://links.spartats.com';
            const QR_COLOR_DARK = '#0A192F';
            const QR_COLOR_LIGHT = '#FFFFFF';

            const yearEl = document.getElementById('current-year');
            const modalEl = document.getElementById('qr-modal');
            const openBtn = document.getElementById('open-qr-modal');
            const closeBtn = document.getElementById('close-qr-modal');
            const urlInput = document.getElementById('hosted-url-input');
            const qrContainer = document.getElementById('qrcode-container');
            const downloadPngBtn = document.getElementById('download-png-btn');
            const downloadSvgBtn = document.getElementById('download-svg-btn');
            const toastEl = document.getElementById('toast');

            let qrInstance = null;
            let toastTimer = null;

            // Set footer year
            yearEl.textContent = new Date().getFullYear();

            // Determine initial hosted URL (use live window.location.href if hosted via http/https, else fallback)
            function getInitialPageUrl() {
                try {
                    const href = window.location.href;
                    if (
                        href &&
                        (href.startsWith('http://') || href.startsWith('https://')) &&
                        !href.includes('srcdoc') &&
                        !href.includes('about:')
                    ) {
                        return href;
                    }
                } catch (e) {}
                return DEFAULT_FALLBACK_URL;
            }

            // Render QR code using qrcodejs
            function renderQRCode(targetUrl) {
                const value = (targetUrl || '').trim() || DEFAULT_FALLBACK_URL;
                qrContainer.innerHTML = '';
                qrInstance = new QRCode(qrContainer, {
                    text: value,
                    width: 210,
                    height: 210,
                    colorDark: QR_COLOR_DARK,
                    colorLight: QR_COLOR_LIGHT,
                    correctLevel: QRCode.CorrectLevel.H
                });
            }

            // Show toast feedback
            function showToast(message) {
                toastEl.textContent = message;
                toastEl.classList.add('is-visible');
                clearTimeout(toastTimer);
                toastTimer = setTimeout(() => {
                    toastEl.classList.remove('is-visible');
                }, 2600);
            }

            // Modal Open / Close handlers
            function openModal() {
                if (!urlInput.value) {
                    urlInput.value = getInitialPageUrl();
                }
                renderQRCode(urlInput.value);
                modalEl.classList.add('is-open');
            }

            function closeModal() {
                modalEl.classList.remove('is-open');
            }

            openBtn.addEventListener('click', openModal);
            closeBtn.addEventListener('click', closeModal);

            modalEl.addEventListener('click', function (e) {
                if (e.target === modalEl) {
                    closeModal();
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && modalEl.classList.contains('is-open')) {
                    closeModal();
                }
            });

            urlInput.addEventListener('input', function () {
                renderQRCode(urlInput.value);
            });

            // High-Resolution PNG Export (1000x1000px with crisp quiet-zone border)
            downloadPngBtn.addEventListener('click', function () {
                try {
                    const targetUrl = urlInput.value.trim() || DEFAULT_FALLBACK_URL;
                    const tempDiv = document.createElement('div');
                    new QRCode(tempDiv, {
                        text: targetUrl,
                        width: 900,
                        height: 900,
                        colorDark: QR_COLOR_DARK,
                        colorLight: QR_COLOR_LIGHT,
                        correctLevel: QRCode.CorrectLevel.H
                    });

                    const sourceCanvas = tempDiv.querySelector('canvas');
                    if (!sourceCanvas) {
                        showToast('Unable to generate PNG.');
                        return;
                    }

                    const finalCanvas = document.createElement('canvas');
                    finalCanvas.width = 1000;
                    finalCanvas.height = 1000;
                    const ctx = finalCanvas.getContext('2d');
                    ctx.fillStyle = QR_COLOR_LIGHT;
                    ctx.fillRect(0, 0, 1000, 1000);
                    ctx.drawImage(sourceCanvas, 50, 50, 900, 900);

                    const link = document.createElement('a');
                    link.download = 'sparta-connect-qr.png';
                    link.href = finalCanvas.toDataURL('image/png');
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);

                    showToast('High-Res PNG downloaded');
                } catch (err) {
                    showToast('Error downloading PNG');
                }
            });

            // Crisp Vector SVG Export extracted from QRCode matrix
            downloadSvgBtn.addEventListener('click', function () {
                try {
                    if (!qrInstance || !qrInstance._oQRCode) {
                        showToast('Unable to generate SVG.');
                        return;
                    }

                    const qrModel = qrInstance._oQRCode;
                    const count = qrModel.getModuleCount();
                    const margin = 4;
                    const totalSize = count + margin * 2;

                    let paths = '';
                    for (let r = 0; r < count; r++) {
                        for (let c = 0; c < count; c++) {
                            if (qrModel.isDark(r, c)) {
                                paths += `<rect x="${c + margin}" y="${r + margin}" width="1" height="1" fill="${QR_COLOR_DARK}"/>`;
                            }
                        }
                    }

                    const svgMarkup = `<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${totalSize} ${totalSize}" width="1000" height="1000" shape-rendering="crispEdges">
  <rect width="${totalSize}" height="${totalSize}" fill="${QR_COLOR_LIGHT}"/>
  ${paths}
</svg>`;

                    const blob = new Blob([svgMarkup], { type: 'image/svg+xml;charset=utf-8' });
                    const blobUrl = URL.createObjectURL(blob);
                    const link = document.createElement('a');
                    link.href = blobUrl;
                    link.download = 'sparta-connect-qr.svg';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    URL.revokeObjectURL(blobUrl);

                    showToast('Vector SVG downloaded');
                } catch (err) {
                    showToast('Error downloading SVG');
                }
            });

            // Initialize default URL value
            urlInput.value = getInitialPageUrl();
        })();
    </script>
</body>
</html>
